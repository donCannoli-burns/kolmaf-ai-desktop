#!/usr/bin/env bash
# Portable checkpoint verifier for the commissioned native.can-equip path.
# Repository-only: safe for public CI. Proves the public attestation, source
# registry, canonical helper identity/hash, transport/authority coherence,
# intent routing, helper shape, parseability, and source provenance.
# Never requires machine-local runtime state, the installed relay helper,
# live provider health, relay reachability, or the receipt journal.
# Prints PORTABLE CHECKPOINT VALID on success; never claims installed-runtime
# READY. For machine-local checks use verify-native-can-equip-checkpoint-local.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

exec "${PYTHON:-python3}" "$SCRIPT_DIR/verify_native_can_equip_checkpoint.py" \
  --mode portable --project-root "$PROJECT_ROOT"
